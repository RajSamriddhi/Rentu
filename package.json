{
  "name": "borrowflex-root",
  "version": "1.0.0",
  "description": "Rentu⁺ - Gen Z Peer-to-Peer Gear Sharing & Rental Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
